# Trackable copy of root .env.example (gitignores `.env.*`).
# Copy to `../.okavo-agent` or export these for scripts.
#
# Staging is the default target for seeds and security tests.
# The agent console (okavo.mjs) may still default to production for read-only
# inspection when SUPABASE_PROJECT_REF is unset.

OKAVO_ENV=staging

# Staging Supabase project
SUPABASE_PROJECT_REF=your-staging-ref
SUPABASE_URL=https://your-staging-ref.supabase.co
SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key

# Management API token (accounts / sql / seed-test-data)
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-personal-access-token

# Browser / screenshots
OKAVO_SITE=http://127.0.0.1:5180

# Production project ref (read-only console only): fzgnzaflvbimbiseqnrz
# Never set the next line in CI.
# OKAVO_ALLOW_PRODUCTION_DESTRUCTIVE=1

# Optional salts / secrets used by edge + Vercel functions (set in dashboards,
# not required for the agent console):
# RATE_LIMIT_SALT=okavo-edge-v1
# IDENTITY_SWEEP_SECRET=
# RAZORPAY_RECONCILE_SECRET=
# RAZORPAY_PAYMENTS_ENABLED=false
